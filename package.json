{
  "name": "car-identifier",
  "version": "1.0.0",
  "description": "Car identifier webapp using Claude AI",
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "dev": "concurrently \"node server/index.js\" \"npm run dev --prefix client\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clerk/express": "^1.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
